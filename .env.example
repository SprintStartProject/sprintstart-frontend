# ==============================================================================
# SprintStart Frontend — Environment Configuration
# ==============================================================================
# API requests (`/api`, `/v1`) and authentication endpoints (`/auth`) are reached
# through the frontend's own origin and reverse-proxied from there, so no authority
# URL, API base URL or redirect URI has to be configured here.
#
# Running `npm run dev`, Vite proxies to:
#   - Backend API:  http://127.0.0.1:8080 (via /api and /v1)
#   - Keycloak IAM: http://127.0.0.1:8081 (via /auth)
#
# Under `docker compose up`, Nginx forwards /api and /auth to host.docker.internal
# on the same ports. The README's Architecture section has the full routing table,
# including where the Kubernetes manifests differ.
# ==============================================================================

# Keycloak Client ID registered in the 'sprintstart' realm
# (Defaults to 'sprintstart-frontend' if unset)
VITE_KEYCLOAK_CLIENT_ID=sprintstart-frontend

# ------------------------------------------------------------------------------
# Optional Developer / Local Preview Flags
# ------------------------------------------------------------------------------
# Run the isolated Keycloak theme preview with mock context (`npm run dev-keycloak-theme`):
# VITE_KC_DEV=true
