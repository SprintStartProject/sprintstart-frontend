# Settings for the throw-away end-to-end stack only. None of these values is a secret: the stack runs
# on a developer machine or a CI runner and is deleted afterwards.
POSTGRES_DB=sprintstart
POSTGRES_USER=sprintstart
POSTGRES_PASSWORD=e2e-only
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=e2e-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=e2e-only
SPRINTSTART_KEYCLOAK_SHARED_SECRET=e2e-only
SPRINTSTART_BACKEND_EVENT_URL=http://backend:8080/api/v1/internal/keycloak/events
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/auth/realms/sprintstart
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/auth/realms/sprintstart/protocol/openid-connect/certs
SPRINTSTART_AI_BASE_URL=http://ai-stub:8000
CRYPTO_MASTER_KEY=e2e-only-master-key
CRYPTO_SALT=0123456789abcdef
GITHUB_PAT=
