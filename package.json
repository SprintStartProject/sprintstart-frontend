{
  "name": "sprintstart-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "keycloakify sync-extensions",
    "dev": "vite",
    "test": "vitest run",
    "unit": "vitest run --exclude 'tests/unit/a11y/**/*'",
    "a11y": "vitest run tests/unit/a11y/",
    "try": "npm install && npm run build && npm run lint && npm run unit && npm run a11y",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "dev-keycloak-theme": "VITE_KC_DEV=true npm run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@keycloakify/login-ui": "~250004.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "boring-avatars": "^2.0.4",
    "framer-motion": "^12.40.0",
    "github-markdown-css": "^5.9.0",
    "katex": "^0.17.0",
    "keycloak-js": "^26.2.4",
    "keycloakify": "^11.15.10",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "tsafe": "^1.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@keycloakify/login-ui-storybook": "~250004.2.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "storybook": "^10.4.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  }
}
